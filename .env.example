# Copy this file to .env and fill in your own values. .env is git-ignored.

# Your key from https://developer.nationaltransport.ie/
NTA_API_KEY=

# Optional overrides (defaults shown)
# NTA_TRIP_UPDATES_URL=https://api.nationaltransport.ie/gtfsr/v2/TripUpdates
# NTA_VEHICLES_URL=https://api.nationaltransport.ie/gtfsr/v2/Vehicles
# NTA_API_KEY_HEADER=x-api-key

# NTA fair-usage policy: at most one call every 60 seconds per key.
# POLL_INTERVAL_SECONDS=60
